# Clips settings -- shared by ~/.local/bin/clip-start and clip-ui.
# No spaces around "=". Quote values: this file is sourced by bash, so an
# unquoted "a|b" would be parsed as a pipe instead of a value.

# Default length used by `clip-save` with no argument (seconds).
CLIP_SECONDS=30

# RAM replay buffer length; must be at least the longest clip you want to save.
CLIP_BUFFER_SECONDS=60

# Empty = whichever monitor is active when the buffer starts.
# Otherwise a monitor name from `gpu-screen-recorder --list-capture-options`
# (eDP-1 / HDMI-A-1 ...).
CLIP_MONITOR=""

# "|" mixes several sources. default_output = system/game audio,
# default_input = default microphone, ee_source_group = Easy Effects mic chain.
# Microphone only: "default_input". Game audio only: "default_output".
CLIP_AUDIO="default_output|default_input"

CLIP_FPS=60

# Constant bitrate in kbit/s. RAM use ~ CLIP_BUFFER_SECONDS * CLIP_QUALITY/8/1024 MB.
CLIP_QUALITY=18000
